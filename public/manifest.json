{
  "manifest_version": 3,
  "name": "Scenic New Tab",
  "version": "1.7.1",
  "description": "Scenic",
  "author": "Varun Gaikwad",
  "permissions": ["tabs", "storage", "activeTab", "geolocation"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://omni-vox-ten.vercel.app/"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
